<?xml version="1.0" encoding="utf-8"?>
<!-- Matches MetricSphere/public/favicon.svg — Activity mark on emerald→cyan. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full-bleed gradient (adaptive launchers apply their own mask) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="13.5"
                android:startY="13.5"
                android:endX="94.5"
                android:endY="94.5"
                android:type="linear">
                <item android:offset="0" android:color="#FF34D399" />
                <item android:offset="1" android:color="#FF06B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      Favicon activity path is in a 24×24 box at (4,4) inside 32×32.
      Scale 32→72 and center in 108: translate 18, scale 2.25, then +4,+4 for the path group.
    -->
    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="2.25"
        android:scaleY="2.25">
        <group android:translateX="4" android:translateY="4">
            <path
                android:pathData="M22,12h-2.48a2,2 0 0 0,-1.93,1.46l-2.35,8.36a0.25,0.25 0 0 1,-0.48,0L9.24,2.18a0.25,0.25 0 0 0,-0.48,0l-2.35,8.36A2,2 0 0 1,4.49,12H2"
                android:fillColor="#00000000"
                android:strokeWidth="2"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </group>
    </group>
</vector>
